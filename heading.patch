diff --git a/css/gantt-timeline.css b/css/gantt-timeline.css
index 7b01dd6..54259ab 100644
--- a/css/gantt-timeline.css
+++ b/css/gantt-timeline.css
@@ -2048,6 +2048,35 @@ a.libcal-gantt-agenda__link:focus {
   text-transform: uppercase;
 }
 
+/* Visually hidden, still announced. The first band's heading is redundant
+   on screen - the today card beside it is outlined and badged - but it is
+   the accessible name of that band's group and the block's only h3, so it
+   has to stay in the accessibility tree. See startBand() for why only the
+   first one.
+
+   Not `display: none` and not `visibility: hidden`: both of those take the
+   element out of the accessibility tree too, which would leave a
+   role="group" with no name. This is the standard clip pattern, spelled out
+   here rather than borrowed from the theme so the block does not depend on
+   a `visually-hidden` class it cannot guarantee is present.
+
+   Taking it out of flow also cleans up after itself: `.libcal-gantt-home__bands`
+   draws its hairlines with `gap` over a background, so an in-flow hidden
+   heading would still reserve a gap and leave a stray 1px rule across the
+   top of the block. */
+.libcal-gantt-home__week-heading--offscreen {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  margin: -1px;
+  padding: 0;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  clip-path: inset(50%);
+  border: 0;
+  white-space: nowrap;
+}
+
 .libcal-gantt-home__reveal {
   display: flex;
   justify-content: center;
